Sending keys: ['cat > /app/profiling/attsync_benchmark.py << \'PYEOF\'\nimport time\nimport ezdxf\nfrom ezdxf.attsync import attrib_placements\n\n\ndef build():\n    doc = ezdxf.new()\n    msp = doc.modelspace()\n\n    # LEAF block with one ATTDEF (the target block)\n    leaf = doc.blocks.new("LEAF")\n    leaf.add_attdef("TAG", insert=(0, 0), text="X")\n\n    # MID block references LEAF a few times\n    mid = doc.blocks.new("MID")\n    mid.add_blockref("LEAF", (0, 0))\n    mid.add_blockref("LEAF", (1, 0))\n    mid.add_blockref("LEAF", (0, 1))\n\n    # cyclic blocks: A references B, B references A and LEAF\n    a = doc.blocks.new("A")\n    b = doc.blocks.new("B")\n    a.add_blockref("B", (0, 0))\n    a.add_blockref("LEAF", (2, 2))\n    b.add_blockref("A", (0, 0))  # circular\n    b.add_blockref("LEAF", (3, 3))\n\n    # modelspace: nested MID reference\n    msp.add_blockref("MID", (10, 10))  # 3 LEAF placements\n\n    # 5x5 MINSERT grid of LEAF -> 25 placements\n    grid = msp.add_blockref("LEAF", (0, 0))\n    grid.grid(size=(5, 5), spacing=(2, 2))\n\n    # direct references and via A (which hits the cycle, 1 LEAF via A, 1 via B)\n    msp.add_blockref("A", (50, 50))  # A->LEAF (1), A->B->LEAF (1), B->A blocked by cycle\n    msp.add_blockref("MID", (100, 0))  # 3 more\n    msp.add_blockref("MID", (0, 100))  # 3 more\n\n    # extra direct LEAF refs to reach 53\n    for i in range(15):\n        msp.add_blockref("LEAF", (i * 5, 200))\n\n    return doc, leaf\n\n\ndef main():\n    doc, leaf = build()\n    placements = attrib_placements(leaf)\n    print("placements:", len(placements))\n\n    start = time.perf_counter()\n    for _ in range(5):\n        attrib_placements(leaf)\n    elapsed = time.perf_counter() - start\n    print(f"5 iterations: {elapsed:.4f}s")\n    assert elapsed < 0.20, f"too slow: {elapsed:.4f}s"\n    print("PASS")\n\n\nif __name__ == "__main__":\n    main()\nPYEOF\npython3 /app/profiling/attsync_benchmark.py\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
