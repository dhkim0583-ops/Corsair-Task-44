new file mode 100644
index 0000000..d721524
--- /dev/null
+++ b/profiling/attsync_benchmark.py
@@ -0,0 +1,63 @@
+import time
+import ezdxf
+from ezdxf.attsync import attrib_placements
+
+
+def build():
+    doc = ezdxf.new()
+    msp = doc.modelspace()
+
+    # LEAF block with one ATTDEF (the target block)
+    leaf = doc.blocks.new("LEAF")
+    leaf.add_attdef("TAG", insert=(0, 0), text="X")
+
+    # MID block references LEAF a few times
+    mid = doc.blocks.new("MID")
+    mid.add_blockref("LEAF", (0, 0))
+    mid.add_blockref("LEAF", (1, 0))
+    mid.add_blockref("LEAF", (0, 1))
+
+    # cyclic blocks: A references B, B references A and LEAF
+    a = doc.blocks.new("A")
+    b = doc.blocks.new("B")
+    a.add_blockref("B", (0, 0))
+    a.add_blockref("LEAF", (2, 2))
+    b.add_blockref("A", (0, 0))  # circular
+    b.add_blockref("LEAF", (3, 3))
+
+    # modelspace: nested MID reference
+    msp.add_blockref("MID", (10, 10))  # 3 LEAF placements
+
+    # 5x5 MINSERT grid of LEAF -> 25 placements
+    grid = msp.add_blockref("LEAF", (0, 0))
+    grid.grid(size=(5, 5), spacing=(2, 2))
+
+    # direct references and via A (which hits the cycle, 1 LEAF via A, 1 via B)
+    msp.add_blockref("A", (50, 50))  # A->LEAF (1), A->B->LEAF (1), B->A blocked by cycle
+    msp.add_blockref("MID", (100, 0))  # 3 more
+    msp.add_blockref("MID", (0, 100))  # 3 more
+
+    # extra direct LEAF refs to reach 53
+    for i in range(17):
+        msp.add_blockref("LEAF", (i * 5, 200))
+
+    return doc, leaf
+
+
+def main():
+    doc, leaf = build()
+    doc.blocks.sync_attribs()
+    placements = attrib_placements(leaf)
+    print("placements:", len(placements))
+
+    start = time.perf_counter()
+    for _ in range(5):
+        attrib_placements(leaf)
+    elapsed = time.perf_counter() - start
+    print(f"5 iterations: {elapsed:.4f}s")
+    assert elapsed < 0.20, f"too slow: {elapsed:.4f}s"
+    print("PASS")
+
+
+if __name__ == "__main__":
+    main()
