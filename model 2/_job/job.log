Sending keys: ['cat > benchmark_attsync.py << \'EOF\'\nimport ezdxf\nimport time\nfrom ezdxf.math import Matrix44\n\ndoc = ezdxf.new()\nmsp = doc.modelspace()\nblk = doc.blocks.new("TEST_BLOCK")\nblk.add_attdef("TAG1")\n\n# Create nested blocks and MINSERTs to generate 53 placements\n# Simple structure to mimic the load\nfor i in range(10):\n    ref = msp.add_blockref("TEST_BLOCK", (i, 0))\n    if i == 0:\n        # 5x5 MINSERT = 25 placements\n        ref.set_minsert((0, 0), ncols=5, nrows=5)\n    # Nested chain\n    ref2 = blk.add_blockref("TEST_BLOCK", (1, 1))\n    \n# Circular reference\nblk.add_blockref("TEST_BLOCK", (2, 2))\n\nstart = time.perf_counter()\nfor _ in range(5):\n    placements = blk.attrib_placements()\nend = time.perf_counter()\n\nprint(f"Time for 5 iterations: {end - start:.4f} seconds")\nif (end - start) < 0.20:\n    print("Performance requirement met!")\nelse:\n    print("Performance requirement failed!")\nEOF\npython3 benchmark_attsync.py\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
