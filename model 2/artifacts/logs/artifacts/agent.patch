diff --git a/benchmark_attsync.py b/benchmark_attsync.py
new file mode 100644
index 0000000..7a10464
--- /dev/null
+++ b/benchmark_attsync.py
@@ -0,0 +1,32 @@
+import ezdxf
+import time
+from ezdxf.math import Matrix44
+
+doc = ezdxf.new()
+msp = doc.modelspace()
+blk = doc.blocks.new("TEST_BLOCK")
+blk.add_attdef("TAG1")
+
+# Create nested blocks and MINSERTs to generate 53 placements
+# Simple structure to mimic the load
+for i in range(10):
+    ref = msp.add_blockref("TEST_BLOCK", (i, 0))
+    if i == 0:
+        # 5x5 MINSERT = 25 placements
+        ref.set_minsert((0, 0), ncols=5, nrows=5)
+    # Nested chain
+    ref2 = blk.add_blockref("TEST_BLOCK", (1, 1))
+    
+# Circular reference
+blk.add_blockref("TEST_BLOCK", (2, 2))
+
+start = time.perf_counter()
+for _ in range(5):
+    placements = blk.attrib_placements()
+end = time.perf_counter()
+
+print(f"Time for 5 iterations: {end - start:.4f} seconds")
+if (end - start) < 0.20:
+    print("Performance requirement met!")
+else:
+    print("Performance requirement failed!")
