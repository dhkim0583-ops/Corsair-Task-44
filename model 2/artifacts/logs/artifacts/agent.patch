+
+doc = ezdxf.new()
+msp = doc.modelspace()
+blk = doc.blocks.new("TEST_BLOCK")
+blk.add_attdef("TAG1")
+insert = msp.add_blockref("TEST_BLOCK", (0, 0))
+
+try:
+    insert.sync_attribs()
+except AttributeError as e:
+    print(f"Caught expected error on insert: {e}")
+
+try:
+    blk.sync_attribs()
+except AttributeError as e:
+    print(f"Caught expected error on block: {e}")
+
+try:
+    doc.blocks.sync_attribs()
+except AttributeError as e:
+    print(f"Caught expected error on doc.blocks: {e}")
