Sending keys: ['python3 -c "import ezdxf, time\nfrom typing import Iterator, cast\nfrom ezdxf.math import Matrix44, Vec3, NULLVEC\nfrom ezdxf.entities import Attrib, Insert, BlockRecord\nfrom ezdxf.layouts import BaseLayout, BlockLayout\nimport ezdxf.attsync as attsync\n\ndef _grid_opt(insert: Insert) -> Iterator[Insert]:\n    if insert.mcount > 1:\n        yield from insert.multi_insert()\n    else:\n        yield insert\n\ndef _walk_opt(\n    layout: BaseLayout,\n    target_record: BlockRecord,\n    matrix: Matrix44,\n    chain: set[str],\n    placements: list[attsync.AttribPlacement],\n) -> None:\n    for entity in layout:\n        if not isinstance(entity, Insert) or not entity.is_alive:\n            continue\n        referenced = entity.block()\n        if referenced is None:\n            continue\n        ref_record = referenced.block_record\n        ref_handle = ref_record.dxf.handle\n        for element in _grid_opt(entity):\n            elem_matrix = element.matrix44()\n            current_matrix = elem_matrix * matrix\n            if ref_record is target_record:\n                for attrib in element.attribs:\n                    placed = cast(Attrib, attrib.copy())\n                    placed.transform(current_matrix)\n                    placements.append(\n                        attsync.AttribPlacement(\n                            placed.dxf.get(\'tag\', \'\'),\n                            placed.dxf.get(\'text\', \'\'),\n                            Vec3(placed.dxf.get(\'insert\', NULLVEC)),\n                            placed.dxf.get(\'rotation\', 0.0),\n                            placed.dxf.get(\'height\', 0.0),\n                            entity,\n                        )\n                    )\n            if ref_handle not in chain:\n                _walk_opt(\n                    referenced,\n                    target_record,\n                    current_matrix,\n                    chain | {ref_handle},\n                    placements,\n                )\n\ndef attrib_placements_opt(block: BlockLayout) -> list[attsync.AttribPlacement]:\n    doc = block.doc\n    if doc is None:\n        return []\n    placements: list[attsync.AttribPlacement] = []\n    target_record = block.block_record\n    for layout in attsync._layouts(doc):\n        _walk_opt(layout, target_record, Matrix44(), set(), placements)\n    return placements\n\ndoc = ezdxf.new()\nblk_target = doc.blocks.new(\'TARGET\')\nblk_target.add_attdef(\'TAG1\', (0, 0), text=\'VAL1\')\n\nblk_cyclic = doc.blocks.new(\'CYCLIC\')\nins_t = blk_cyclic.add_blockref(\'TARGET\', (5, 5))\nattsync.sync_block_reference(ins_t)\nins_c = blk_cyclic.add_blockref(\'CYCLIC\', (1, 1))\n\nblk_grid = doc.blocks.new(\'GRID\')\nins_grid = blk_grid.add_blockref(\'TARGET\', (0, 0))\nins_grid.grid((5, 5), (10, 10))\nattsync.sync_block_reference(ins_grid)\n\nblk_nested = doc.blocks.new(\'NESTED\')\nins_g = blk_nested.add_blockref(\'GRID\', (100, 100))\nins_cyc = blk_nested.add_blockref(\'CYCLIC\', (50, 50))\nfor i in range(1):\n    ins_t_n = blk_nested.add_blockref(\'TARGET\', (i * 10, 0))\n    attsync.sync_block_reference(ins_t_n)\n\nmsp = doc.modelspace()\nins_t_msp = msp.add_blockref(\'TARGET\', (0, 0))\nattsync.sync_block_reference(ins_t_msp)\n\nins_grid_msp = msp.add_blockref(\'TARGET\', (200, 200))\nins_grid_msp.grid((5, 5), (20, 20))\nattsync.sync_block_reference(ins_grid_msp)\n\nins_n = msp.add_blockref(\'NESTED\', (500, 500))\n\nt0 = time.perf_counter()\nfor _ in range(5):\n    res = attrib_placements_opt(blk_target)\nt1 = time.perf_counter()\nprint(\'Placements count:\', len(res))\nprint(\'Time for 5 iterations:\', t1 - t0)\n"\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
