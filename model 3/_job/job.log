Sending keys: ['cat << \'EOF\' > benchmark_attsync.py\nimport time\nimport ezdxf\n\ndef run_benchmark():\n    doc = ezdxf.new()\n\n    # 1. Target block definition with 1 ATTDEF entity\n    blk_target = doc.blocks.new("TARGET")\n    blk_target.add_attdef("TAG1", (0, 0), text="VAL1")\n\n    # 2. Block CYCLIC: contains Insert TARGET (1 placement) and cyclic self-reference\n    blk_cyclic = doc.blocks.new("CYCLIC")\n    ins_t_cyc = blk_cyclic.add_blockref("TARGET", (5, 5))\n    ins_t_cyc.sync_attribs()\n    blk_cyclic.add_blockref("CYCLIC", (1, 1))  # Circular reference loop\n\n    # 3. Block GRID: 5x5 MINSERT grid of TARGET (25 placements)\n    blk_grid = doc.blocks.new("GRID")\n    ins_grid = blk_grid.add_blockref("TARGET", (0, 0))\n    ins_grid.grid((5, 5), (10, 10))\n    ins_grid.sync_attribs()\n\n    # 4. Block NESTED: contains GRID, CYCLIC, and 1 direct TARGET (25 + 1 + 1 = 27 placements)\n    blk_nested = doc.blocks.new("NESTED")\n    blk_nested.add_blockref("GRID", (100, 100))\n    blk_nested.add_blockref("CYCLIC", (50, 50))\n    ins_t_nested = blk_nested.add_blockref("TARGET", (10, 0))\n    ins_t_nested.sync_attribs()\n\n    # 5. Modelspace:\n    # - 1 direct TARGET reference (1 placement)\n    # - 5x5 MINSERT grid of TARGET (25 placements)\n    # - 1 reference to NESTED (27 placements)\n    # Total placements = 1 + 25 + 27 = 53 placements\n    msp = doc.modelspace()\n    ins_t_msp = msp.add_blockref("TARGET", (0, 0))\n    ins_t_msp.sync_attribs()\n\n    ins_grid_msp = msp.add_blockref("TARGET", (200, 200))\n    ins_grid_msp.grid((5, 5), (20, 20))\n    ins_grid_msp.sync_attribs()\n\n    msp.add_blockref("NESTED", (500, 500))\n\n    # Benchmark 5 iterations of attribute placement calculation\n    t0 = time.perf_counter()\n    for _ in range(5):\n        placements = blk_target.attrib_placements()\n    t1 = time.perf_counter()\n\n    elapsed = t1 - t0\n    print(f"Placements count: {len(placements)}")\n    print(f"Wall-clock time for 5 iterations: {elapsed:.4f} seconds")\n\n    assert len(placements) == 53, f"Expected 53 placements, got {len(placements)}"\n    assert elapsed < 0.20, f"Benchmark failed: elapsed time {elapsed:.4f}s >= 0.20s"\n    print("Benchmark PASSED successfully!")\n\nif __name__ == "__main__":\n    run_benchmark()\nEOF\npython3 benchmark_attsync.py\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
