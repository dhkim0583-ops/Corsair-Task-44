Sending keys: ['python3 -c "import ezdxf, time\nimport ezdxf.attsync as attsync\n\ndoc = ezdxf.new()\n\n# Create block definition \'TARGET\' with 1 ATTDEF\nblk_target = doc.blocks.new(\'TARGET\')\nblk_target.add_attdef(\'TAG1\', (0, 0), text=\'VAL1\')\n\n# Create block definition \'CYCLIC\' which has Insert TARGET and Insert CYCLIC (self cycle)\nblk_cyclic = doc.blocks.new(\'CYCLIC\')\nins_t = blk_cyclic.add_blockref(\'TARGET\', (5, 5))\nattsync.sync_block_reference(ins_t)\nins_c = blk_cyclic.add_blockref(\'CYCLIC\', (1, 1)) # cycle!\n\n# Create block definition \'GRID\' which has 5x5 minsert of TARGET (25 placements)\nblk_grid = doc.blocks.new(\'GRID\')\nins_grid = blk_grid.add_blockref(\'TARGET\', (0, 0))\nins_grid.grid((5, 5), (10, 10))\nattsync.sync_block_reference(ins_grid)\n\n# Create block definition \'NESTED\' which has Insert GRID and Insert CYCLIC and 3 Insert TARGETs\nblk_nested = doc.blocks.new(\'NESTED\')\nins_g = blk_nested.add_blockref(\'GRID\', (100, 100))\nins_cyc = blk_nested.add_blockref(\'CYCLIC\', (50, 50))\nfor i in range(3):\n    ins_t_n = blk_nested.add_blockref(\'TARGET\', (i * 10, 0))\n    attsync.sync_block_reference(ins_t_n)\n\n# Modelspace:\nmsp = doc.modelspace()\n# 1) Direct Insert TARGET in msp (1 placement)\nins_t_msp = msp.add_blockref(\'TARGET\', (0, 0))\nattsync.sync_block_reference(ins_t_msp)\n\n# 2) 5x5 minsert of TARGET in msp (25 placements)\nins_grid_msp = msp.add_blockref(\'TARGET\', (200, 200))\nins_grid_msp.grid((5, 5), (20, 20))\nattsync.sync_block_reference(ins_grid_msp)\n\n# 3) Insert NESTED in msp (25 from GRID + 1 from CYCLIC + 3 direct = 29 placements)\nins_n = msp.add_blockref(\'NESTED\', (500, 500))\n\n# Total placements for TARGET: 1 + 25 + 29 = 55 placements!\n\nprint(\'Target block records and structure set up.\')\n"\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
