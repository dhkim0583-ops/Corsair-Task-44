ort attsync\n\n        return attsync.delete_attdef(self, tag)\n\n    def reorder_attdefs(self, tags: Sequence[str]) -> AttribSyncReport:\n        """Rearranges the ATTDEF entities of this block in the order of `tags`."""\n        from ezdxf import attsync\n\n        return attsync.reorder_attdefs(self, tags)\n\'\'\'\n\ntarget_anchor = "    def update_block_flags(self):"\nif target_anchor in content and "def sync_attribs" not in content:\n    content = content + "\\n" + new_methods\n    with open(\'src/ezdxf/layouts/blocklayout.py\', \'w\') as f:\n        f.write(content)\n    print("Patched blocklayout.py successfully")\nelse:\n    print("Error patching blocklayout.py")\nEOF\npython3 patch_blocklayout.py\nrm patch_blocklayout.py\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
