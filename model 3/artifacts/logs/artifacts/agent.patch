diff --git a/tests/test_attsync_gate.py b/tests/test_attsync_gate.py
new file mode 100644
index 0000000..896cfaf
--- /dev/null
+++ b/tests/test_attsync_gate.py
@@ -0,0 +1,142 @@
+import time
+import pytest
+import ezdxf
+from ezdxf.math import Vec3
+
+
+def test_insert_sync_attribs():
+    doc = ezdxf.new()
+    blk = doc.blocks.new("BLK1")
+    blk.add_attdef("TAG1", (0, 0), text="A")
+
+    msp = doc.modelspace()
+    ins = msp.add_blockref("BLK1", (10, 10))
+    report = ins.sync_attribs()
+
+    assert report.added == 1
+    assert len(ins.attribs) == 1
+    assert ins.attribs[0].dxf.tag == "TAG1"
+
+
+def test_blocklayout_convenience_methods():
+    doc = ezdxf.new()
+    blk = doc.blocks.new("BLK2")
+    blk.add_attdef("TAG_A", (0, 0), text="A")
+    blk.add_attdef("TAG_B", (5, 5), text="B")
+
+    msp = doc.modelspace()
+    ins = msp.add_blockref("BLK2", (100, 100))
+
+    # sync_attribs & out_of_sync_references
+    out_of_sync = blk.out_of_sync_references()
+    assert len(out_of_sync) == 1
+    report = blk.sync_attribs()
+    assert report.added == 2
+    assert len(blk.out_of_sync_references()) == 0
+
+    # attrib_placements
+    placements = blk.attrib_placements()
+    assert len(placements) == 2
+    tags = {p.tag for p in placements}
+    assert tags == {"TAG_A", "TAG_B"}
+
+    # rename_attdef
+    blk.rename_attdef("TAG_A", "RENAMED_A")
+    assert blk.get_attdef("RENAMED_A") is not None
+    assert ins.attribs[0].dxf.tag == "RENAMED_A"
+
+    # reorder_attdefs
+    blk.reorder_attdefs(["TAG_B", "RENAMED_A"])
+    assert list(blk.attdefs())[0].dxf.tag == "TAG_B"
+
+    # delete_attdef
+    blk.delete_attdef("TAG_B")
+    assert blk.get_attdef("TAG_B") is None
+    assert len(ins.attribs) == 1
+
+
+def test_doc_blocks_sync_attribs():
+    doc = ezdxf.new()
+    blk = doc.blocks.new("BLK3")
+    blk.add_attdef("T1", (0, 0), text="1")
+
+    msp = doc.modelspace()
+    ins = msp.add_blockref("BLK3", (0, 0))
+
+    report = doc.blocks.sync_attribs()
+    assert report.added == 1
+    assert len(ins.attribs) == 1
+
+
+def test_nested_minsert_cyclic_wcs_placements():
+    doc = ezdxf.new()
+
+    blk_t = doc.blocks.new("TARGET")
+    blk_t.add_attdef("TAG", (1, 2), text="VAL")
+
+    blk_g = doc.blocks.new("GRID")
+    ins_g = blk_g.add_blockref("TARGET", (10, 20))
+    ins_g.grid((2, 2), (10, 10))
+    ins_g.sync_attribs()
+
+    blk_n = doc.blocks.new("NESTED")
+    blk_n.add_blockref("GRID", (100, 200))
+    blk_n.add_blockref("NESTED", (1, 1))  # Cyclic loop
+
+    msp = doc.modelspace()
+    msp.add_blockref("NESTED", (1000, 2000))
+
+    placements = blk_t.attrib_placements()
+    assert len(placements) == 4
+
+    expected_locations = {
+        Vec3(1111, 2222, 0),
+        Vec3(1121, 2222, 0),
+        Vec3(1111, 2232, 0),
+        Vec3(1121, 2232, 0),
+    }
+
+    actual_locations = {p.location for p in placements}
+    assert actual_locations == expected_locations
+
+
+def test_attrib_placement_performance():
+    doc = ezdxf.new()
+
+    blk_target = doc.blocks.new("TARGET")
+    blk_target.add_attdef("TAG1", (0, 0), text="VAL1")
+
+    blk_cyclic = doc.blocks.new("CYCLIC")
+    ins_t_cyc = blk_cyclic.add_blockref("TARGET", (5, 5))
+    ins_t_cyc.sync_attribs()
+    blk_cyclic.add_blockref("CYCLIC", (1, 1))
+
+    blk_grid = doc.blocks.new("GRID")
+    ins_grid = blk_grid.add_blockref("TARGET", (0, 0))
+    ins_grid.grid((5, 5), (10, 10))
+    ins_grid.sync_attribs()
+
+    blk_nested = doc.blocks.new("NESTED")
+    blk_nested.add_blockref("GRID", (100, 100))
+    blk_nested.add_blockref("CYCLIC", (50, 50))
+    ins_t_nested = blk_nested.add_blockref("TARGET", (10, 0))
+    ins_t_nested.sync_attribs()
+
+    msp = doc.modelspace()
+    ins_t_msp = msp.add_blockref("TARGET", (0, 0))
+    ins_t_msp.sync_attribs()
+
+    ins_grid_msp = msp.add_blockref("TARGET", (200, 200))
+    ins_grid_msp.grid((5, 5), (20, 20))
+    ins_grid_msp.sync_attribs()
+
+    msp.add_blockref("NESTED", (500, 500))
+
+    t0 = time.perf_counter()
+    for _ in range(5):
+        placements = blk_target.attrib_placements()
+    t1 = time.perf_counter()
+
+    elapsed = t1 - t0
+    assert len(placements) == 53
+    assert elapsed < 0.20
