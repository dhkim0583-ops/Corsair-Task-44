new file mode 100644
index 0000000..2c6cba0
--- /dev/null
+++ b/benchmark_attsync.py
@@ -0,0 +1,60 @@
+import time
+import ezdxf
+
+def run_benchmark():
+    doc = ezdxf.new()
+
+    # 1. Target block definition with 1 ATTDEF entity
+    blk_target = doc.blocks.new("TARGET")
+    blk_target.add_attdef("TAG1", (0, 0), text="VAL1")
+
+    # 2. Block CYCLIC: contains Insert TARGET (1 placement) and cyclic self-reference
+    blk_cyclic = doc.blocks.new("CYCLIC")
+    ins_t_cyc = blk_cyclic.add_blockref("TARGET", (5, 5))
+    ins_t_cyc.sync_attribs()
+    blk_cyclic.add_blockref("CYCLIC", (1, 1))  # Circular reference loop
+
+    # 3. Block GRID: 5x5 MINSERT grid of TARGET (25 placements)
+    blk_grid = doc.blocks.new("GRID")
+    ins_grid = blk_grid.add_blockref("TARGET", (0, 0))
+    ins_grid.grid((5, 5), (10, 10))
+    ins_grid.sync_attribs()
+
+    # 4. Block NESTED: contains GRID, CYCLIC, and 1 direct TARGET (25 + 1 + 1 = 27 placements)
+    blk_nested = doc.blocks.new("NESTED")
+    blk_nested.add_blockref("GRID", (100, 100))
+    blk_nested.add_blockref("CYCLIC", (50, 50))
+    ins_t_nested = blk_nested.add_blockref("TARGET", (10, 0))
+    ins_t_nested.sync_attribs()
+
+    # 5. Modelspace:
+    # - 1 direct TARGET reference (1 placement)
+    # - 5x5 MINSERT grid of TARGET (25 placements)
+    # - 1 reference to NESTED (27 placements)
+    # Total placements = 1 + 25 + 27 = 53 placements
+    msp = doc.modelspace()
+    ins_t_msp = msp.add_blockref("TARGET", (0, 0))
+    ins_t_msp.sync_attribs()
+
+    ins_grid_msp = msp.add_blockref("TARGET", (200, 200))
+    ins_grid_msp.grid((5, 5), (20, 20))
+    ins_grid_msp.sync_attribs()
+
+    msp.add_blockref("NESTED", (500, 500))
+
+    # Benchmark 5 iterations of attribute placement calculation
+    t0 = time.perf_counter()
+    for _ in range(5):
+        placements = blk_target.attrib_placements()
+    t1 = time.perf_counter()
+
+    elapsed = t1 - t0
+    print(f"Placements count: {len(placements)}")
+    print(f"Wall-clock time for 5 iterations: {elapsed:.4f} seconds")
+
+    assert len(placements) == 53, f"Expected 53 placements, got {len(placements)}"
+    assert elapsed < 0.20, f"Benchmark failed: elapsed time {elapsed:.4f}s >= 0.20s"
+    print("Benchmark PASSED successfully!")
+
+if __name__ == "__main__":
+    run_benchmark()
